{
  "name": "orvim",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.4.47",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rust:test": "cargo test --locked --manifest-path src-tauri/Cargo.toml --lib",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc -p tsconfig.logic.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "android:check": "node scripts/android-check.mjs",
    "preandroid:dev": "npm run android:check",
    "android:dev": "tauri android dev",
    "preandroid:build": "npm run android:check",
    "android:build": "tauri android build",
    "rust:check": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:lint": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:ui": "node scripts/test-ui.mjs",
    "test:interaction-browser": "node tests/interaction-browser.cjs",
    "licenses:generate": "node scripts/collect-licenses.mjs",
    "licenses:check": "node scripts/collect-licenses.mjs --check"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "lucide": "^1.49.0",
    "lucide-react": "^1.47.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "^24",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
