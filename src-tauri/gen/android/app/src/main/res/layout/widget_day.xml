<android.widget.LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="14dp">
  <android.widget.LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical">
    <android.widget.TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Расписание" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink"/>
    <android.widget.TextView android:id="@+id/widget_now" android:layout_marginEnd="12dp" android:padding="6dp" android:background="@drawable/widget_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Сейчас" android:textColor="@color/widget_ink" android:textSize="11sp"/>
    <android.widget.TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_muted"/>
  </android.widget.LinearLayout>
  <android.widget.ListView android:id="@+id/widget_timeline_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="vertical" android:contentDescription="Расписание по часам"/>
  <android.widget.TextView android:id="@+id/widget_tasks_title" android:layout_width="match_parent" android:layout_height="24dp" android:text="Задачи" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:gravity="center_vertical"/>
  <android.widget.ListView android:id="@+id/widget_task_list" android:layout_width="match_parent" android:layout_height="88dp" android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="vertical"/>
  <android.widget.TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="30dp" android:textSize="12sp" android:textColor="@color/widget_muted" android:gravity="center_vertical"/>
  <android.widget.LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp">
    <android.widget.TextView android:id="@+id/widget_add_task" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/widget_button" android:gravity="center" android:text="+ Задача" android:textSize="13sp" android:textColor="@color/widget_ink"/>
    <android.widget.TextView android:id="@+id/widget_add_thought" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="8dp" android:background="@drawable/widget_button" android:gravity="center" android:text="+ Мысль" android:textSize="13sp" android:textColor="@color/widget_ink"/>
  </android.widget.LinearLayout>
</android.widget.LinearLayout>
