<android.widget.FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="@drawable/widget_background" android:paddingStart="12dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp">
  <android.widget.LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:orientation="vertical">
    <android.widget.TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="14dp" android:paddingEnd="48dp" android:includeFontPadding="false" android:gravity="center_vertical" android:text="Питание" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_ink"/>
    <android.widget.TextView android:id="@+id/widget_calories" android:layout_width="match_parent" android:layout_height="24dp" android:paddingEnd="48dp" android:includeFontPadding="false" android:gravity="center_vertical" android:text="—" android:textSize="24sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_ink"/>
    <android.widget.TextView android:id="@+id/widget_calorie_goal" android:layout_width="match_parent" android:layout_height="11dp" android:paddingEnd="48dp" android:includeFontPadding="false" android:gravity="center_vertical" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_muted"/>
    <android.widget.ImageView android:id="@+id/widget_calorie_bar" android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="1dp" android:scaleType="fitXY" android:contentDescription="Прогресс калорий"/>
  </android.widget.LinearLayout>
  <android.widget.ImageView android:id="@+id/widget_add_food" android:layout_width="40dp" android:layout_height="44dp" android:layout_gravity="end|center_vertical" android:padding="8dp" android:scaleType="fitCenter" android:background="@drawable/widget_button" android:src="@drawable/widget_plus" android:contentDescription="Записать еду"/>
</android.widget.FrameLayout>
